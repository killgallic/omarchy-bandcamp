#!/usr/bin/env python3
"""Validate the tracked source tree and the archive Omarchy will install."""
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile
import tomllib
root = Path(__file__).resolve().parents[1]
def git_output(*arguments, text=False):
    result = subprocess.run(['git', *arguments], cwd=root, capture_output=True, text=text)
    if result.returncode:
        error = result.stderr if text else result.stderr.decode(errors='replace')
        raise RuntimeError(f"git {' '.join(arguments)} failed: {error.strip()}")
    return result.stdout

manifest = json.loads((root/'manifest.json').read_text())
project = tomllib.loads((root/'pyproject.toml').read_text())
assert manifest['version'] == project['project']['version']
assert manifest['id'] and '.' in manifest['id']
for path in [*manifest['entryPoints'].values(), 'bin/backend','bin/setup','bin/uninstall','bin/omarchy-bandcamp','share/applications/omarchy-bandcamp.desktop','assets/bandcamp.svg','README.md','LICENSE','uv.lock']:
    assert (root/path).is_file(), path
for path in ['bin/backend','bin/setup','bin/uninstall','bin/omarchy-bandcamp']:
    assert os.access(root/path, os.X_OK), path
subprocess.run(['bash', '-n', 'bin/backend', 'bin/setup', 'bin/uninstall', 'bin/omarchy-bandcamp', 'tests/run-python'], cwd=root, check=True)
if shutil.which('desktop-file-validate'):
    subprocess.run(['desktop-file-validate', 'share/applications/omarchy-bandcamp.desktop'], cwd=root, check=True)
tracked = git_output('ls-files', text=True).splitlines()
for path in tracked:
    assert not any(part in Path(path).parts for part in ('.venv','.cache','__pycache__'))
    assert not path.endswith(('.png','.jpg','.jpeg')) or path.startswith('assets/'), path
archive = git_output('archive', '--format=tar', 'HEAD')
with tarfile.open(fileobj=io.BytesIO(archive)) as source, tempfile.TemporaryDirectory() as temporary:
    members = source.getmembers()
    assert all(not member.issym() and not member.islnk() for member in members), 'Plugin archive contains symlinks'
    assert all('..' not in Path(member.name).parts for member in members), 'Plugin archive contains unsafe paths'
    source.extractall(temporary)
    validator = os.environ.get('OMARCHY_PLUGIN_VALIDATOR')
    if validator:
        assert Path(validator).is_file(), f'Missing required Omarchy validator: {validator}'
        subprocess.run(['bash', validator, temporary], check=True)
        print('Required Omarchy plugin validation passed on the source archive.')
    elif shutil.which('omarchy'):
        subprocess.run(['omarchy', 'plugin', 'validate', temporary], check=True)
        print('Omarchy plugin validation passed on the source archive.')
    else:
        print('Omarchy CLI unavailable; set OMARCHY_PLUGIN_VALIDATOR to require upstream validation.')
print('Package manifest, source archive, and clean-source checks passed.')
